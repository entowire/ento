<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sign-in approvals: a notification per request, confirmed with a fingerprint or the screen lock. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Enrollment QR codes: asked for when someone scans one, used for nothing else. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".EntoApp"
        android:label="ento"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Ento">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The details and Send logs, behind Advanced at the bottom of the main screen. -->
        <activity
            android:name=".AdvancedActivity"
            android:exported="false" />

        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Send logs: the one file it shares, readable only through the permission the share grants. -->
        <provider
            android:name=".LogsProvider"
            android:authorities="com.entowire.ento.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".EntoVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
